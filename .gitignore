# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local settings
.claude/settings.local.json

# reference study material (screenshots of someone else's site, never commit)
/docs/reference/
# the brief for the redesign, which names that site
/REDESIGN_PROMPT.md

# original photos (full size, may carry location metadata). Only the processed
# copies in public/images/home are deployed; see scripts/prepare-home-assets.mjs
/assets-src/
